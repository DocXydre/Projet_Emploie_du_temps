# Copier en .env et adapter. Le fichier .env n'est jamais versionné.

# --- Base de données ---
POSTGRES_DB=planif
POSTGRES_USER=planif
POSTGRES_PASSWORD=a_generer

# Ports côté machine hôte. Changez-les si quelque chose écoute déjà dessus :
# un PostgreSQL local occupe souvent le 5432.
DB_PORT=5433
API_PORT=8000

# 127.0.0.1 : accessible depuis cette machine seulement.
# 0.0.0.0   : accessible depuis le réseau local, pour l'abonnement calendrier
#             du téléphone. À ne faire que sur un réseau de confiance.
API_BIND=127.0.0.1

# Nom par lequel le téléphone joint cette machine, sous la forme « nom:port ».
# Ne pas mettre d'adresse IP : elle change d'un réseau à l'autre et l'abonnement
# du calendrier cesse alors de se rafraîchir. Le nom Bonjour du Mac, lui, reste
# le même partout. Il se lit avec :
#   scutil --get LocalHostName
# et il faut y ajouter « .local » et le port ci-dessus.
HOTE_PUBLIC=mon-mac.local:8000

# --- Trajets en train ---
# Jeton de l'API SNCF (Navitia), à demander sur numerique.sncf.com. Sans lui,
# les fenêtres de départ se calculent quand même : c'est seulement la
# proposition d'horaires qui devient impossible, et le bot le dit.
SNCF_TOKEN=

# Gares, par leur code interne. NANCY et SAINT_DIE sont les seules connues ;
# pour d'autres, mettre directement un identifiant Navitia
# (stop_area:SNCF:87xxxxxx).
GARE_DOMICILE=NANCY
GARE_FAMILLE=SAINT_DIE

# Le temps d'aller à la gare après un cours ou un service. C'est ce qui sépare
# un train qu'on peut prendre d'un train qu'on regarde partir.
MARGE_TRAJET_MINUTES=30

# Durée minimale d'un creux pour qu'un aller-retour se justifie.
FENETRE_ABSENCE_HEURES=48

# --- Boîte aux lettres ---
# Boîte où arrivent les confirmations SNCF. Ta boîte habituelle convient : elle
# est ouverte en lecture seule et lue avec BODY.PEEK, donc rien n'est marqué
# comme lu, déplacé ni supprimé.
#
# Sur Gmail : validation en deux étapes, puis un mot de passe d'application
# (Google → Sécurité). Le mot de passe habituel est refusé par IMAP. À savoir :
# ce mot de passe donne accès à tout le courrier, pas au seul libellé lu ici.
# Il se révoque en un clic depuis le compte Google.
#
# Laisser IMAP_HOTE vide désactive la relève, sans rien casser d'autre.
IMAP_HOTE=
IMAP_PORT=993
IMAP_UTILISATEUR=
IMAP_MOT_DE_PASSE=

# Dossier lu. Sur Gmail, un libellé EST un dossier : créer un filtre
# « De : sncf-connect.com OR info.sncf.com OR connect.sncf » qui applique le
# libellé SNCF, puis mettre ce libellé ici. Un nom avec espace est accepté,
# les guillemets sont ajoutés tout seuls.
IMAP_DOSSIER=INBOX

# Filtre demandé au serveur quand on lit une boîte de réception entière : sans
# lui, on rapatrierait des milliers de courriels pour en analyser trois. Il ne
# remplace pas la liste blanche d'expéditeurs, qui reste seule juge.
IMAP_FILTRE_EXPEDITEUR=sncf

# Profondeur de la relève. Les courriels déjà vus sont reconnus à leur
# Message-ID : relire large ne crée pas de doublon, seulement du trafic.
IMAP_DEPUIS_JOURS=30

# --- Comptes ---
# Clés d'API, au moins 32 caractères. Générer avec :
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48; echo
PLANIF_CLE_THOMAS=a_generer
PLANIF_CLE_LORETTE=a_generer

# --- Flux à collecter ---
# Renseignées au premier démarrage, ou données depuis le bot par
# PATCH /sources/{code}. Elles ne sont jamais écrites dans le dépôt : celle
# d'Easy at Work contient un jeton qui donne accès au planning de travail.
#
# Les URL sont entre guillemets simples : celle d'Easy at Work contient des
# crochets (types[]=shift) qu'un shell prendrait pour des indices de tableau.
IDMC_URL_ICS='https://planning.univ-lorraine.fr/jsp/custom/modules/plannings/anonymous_cal.jsp?resources=25661&projectId=14&calType=ical&firstDate=2026-09-03&lastDate=2026-12-30'
MCDO_URL_ICS=''

# --- Bot Telegram ---
# Sans jeton, l'API tourne normalement mais les notifications restent en file.
TELEGRAM_TOKEN=

# --- Divers ---
FUSEAU=Europe/Paris
HORIZON_JOURS=21
TZ=UTC
