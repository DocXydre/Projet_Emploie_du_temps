# Copier en .env et adapter. Le fichier .env n'est jamais versionné.

# --- Base de données ---
POSTGRES_DB=planif
POSTGRES_USER=planif
POSTGRES_PASSWORD=a_generer
DB_PORT=5432
API_PORT=8000

# --- Comptes ---
# Clés d'API, au moins 32 caractères. Générer avec :
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48; echo
PLANIF_CLE_THOMAS=a_generer
PLANIF_CLE_LORETTE=a_generer

# --- Flux à collecter ---
# Renseignées au premier démarrage, ou données depuis le bot par
# PATCH /sources/{code}. Elles ne sont jamais écrites dans le dépôt : celle
# d'Easy at Work contient un jeton qui donne accès au planning de travail.
IDMC_URL_ICS=https://planning.univ-lorraine.fr/jsp/custom/modules/plannings/anonymous_cal.jsp?resources=25661&projectId=14&calType=ical&firstDate=2026-09-03&lastDate=2026-12-30
MCDO_URL_ICS=

# --- Bot Telegram ---
# Sans jeton, l'API tourne normalement mais les notifications restent en file.
TELEGRAM_TOKEN=

# --- Divers ---
FUSEAU=Europe/Paris
HORIZON_JOURS=21
TZ=UTC
