# Copier en .env et adapter. Le fichier .env n'est jamais versionne.

# --- Base de donnees ---
POSTGRES_DB=planif
POSTGRES_USER=planif
POSTGRES_PASSWORD=changer_ce_mot_de_passe

# --- Coeur metier (Spring Boot) ---
COEUR_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Cle de chiffrement des secrets externes (identifiants de portail, IMAP).
# Generer avec : openssl rand -base64 32
PLANIF_CLE_CHIFFREMENT=a_generer

# Signature des jetons d'authentification. Au moins 32 caracteres.
# Generer avec : openssl rand -base64 48
PLANIF_SECRET_JWT=a_generer

# Comptes crees au premier demarrage. Sans mot de passe, le compte n'est pas
# cree : il n'existe aucun mot de passe par defaut.
PLANIF_ADMIN_IDENTIFIANT=thomas
PLANIF_ADMIN_MOT_DE_PASSE=
PLANIF_STANDARD_IDENTIFIANT=lorette
PLANIF_STANDARD_MOT_DE_PASSE=

# --- Collecteurs (FastAPI) ---
COLLECTEURS_PORT=8000
# URL du coeur metier depuis le reseau Docker interne
PLANIF_URL_COEUR=http://coeur:8080
# Jeton partage entre collecteurs et coeur pour la publication d'occupations
PLANIF_JETON_INTERNE=a_generer

# --- Divers ---
TZ=Europe/Paris

# --- Profil prod uniquement (Caddy) ---
DOMAINE=planif.exemple.fr
