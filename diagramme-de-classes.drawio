        <mxCell id="titre" value="Planificateur personnel : diagramme de classes" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="36" width="860" height="44" as="geometry"/></mxCell>
        <mxCell id="sous_titre" value="23 classes, 217 attributs et 40 associations, tirés du schéma PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="100" y="80" width="860" height="28" as="geometry"/></mxCell>
        <mxCell id="legende" value="&lt;b&gt;Comment lire&lt;/b&gt;&lt;br&gt;{id} : identifiant de la classe&lt;br&gt;{FK} : attribut qui porte une association&lt;br&gt;{unique} : valeur unique&lt;br&gt;[0..1] : attribut facultatif&lt;br&gt;PlageHoraire : un début et une fin&lt;br&gt;Le verbe se lit de la classe côté 1 (ou 0..1) vers l'autre.&lt;br&gt;&lt;br&gt;&lt;b&gt;Couleurs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&amp;#9632;&lt;/font&gt; Comptes&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&amp;#9632;&lt;/font&gt; Sources et emplois du temps&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;&amp;#9632;&lt;/font&gt; Tâches&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;&amp;#9632;&lt;/font&gt; Absences et trajets&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&amp;#9632;&lt;/font&gt; Sport&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;&amp;#9632;&lt;/font&gt; Suivi" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" vertex="1" parent="1"><mxGeometry x="100" y="124" width="380" height="250" as="geometry"/></mxCell>
        <mxCell id="note_journal" value="Le journal n'est relié à rien, exprès : un événement doit survivre à la suppression de ce qu'il décrit. Il désigne son objet par un nom et un numéro." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff9db;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2420" y="70" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="lien_note" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="note_journal" target="c_evenement"><mxGeometry relative="1" as="geometry"/></mxCell>
