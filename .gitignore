# Secrets
.env

# Python
__pycache__/
*.egg-info/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Mémo d'installation du serveur : conservé en local, hors du dépôt public.
docs/

# Copie de la base de production et fichiers de travail locaux : jamais dans le dépôt.
local/

# Les applis iOS : le projet Xcode se régénère avec xcodegen.
*.xcodeproj/
xcuserdata/
DerivedData/
# L'adresse du serveur intégrée à l'appli : hors du dépôt public.
ios/HAL/Serveur.local.xcconfig

# Copies laissées par une fusion (git mergetool), et morceaux refusés d'un patch.
*.orig
*.rej

# Fichiers déposés par l'assistant pendant le travail : jamais dans le dépôt.
Claude outputs/

# Copies faites par iCloud ou le Finder (« fichier 2.sql ») : jamais dans le dépôt.
* [0-9].*
